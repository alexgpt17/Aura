# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!



target 'TintApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Local patch: disable Folly coroutine helpers that depend on
    # missing `folly/coro/Coroutine.h`, which is not shipped in
    # the RCT-Folly version bundled with React Native.
    folly_expected = File.join(__dir__, 'Pods', 'RCT-Folly', 'folly', 'Expected.h')
    if File.exist?(folly_expected)
      contents = File.read(folly_expected)
      needle = '#if FOLLY_HAS_COROUTINES'
      replacement = '#if 0 && FOLLY_HAS_COROUTINES'
      if contents.include?(needle) && !contents.include?(replacement)
        # RCT-Folly headers are often unpacked read-only; ensure writable before patching
        File.chmod(0644, folly_expected)
        File.write(folly_expected, contents.sub(needle, replacement))
        puts 'Patched RCT-Folly Expected.h to disable missing folly/coro/Coroutine.h include'
      end
    end
  end
end
